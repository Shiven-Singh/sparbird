# CALL-E Developer API key, from https://dashboard.heycall-e.com
CALLE_API_KEY=

# The ONLY phone number Sparbird will ever dial: yours, in E.164 form.
# A drill that resolves to any other number is refused before the API is called.
OWNER_E164=+910000000000

# Live calls are off unless this is exactly "1".
# Unset or any other value runs the app from recorded fixtures and places no call.
SPARBIRD_LIVE=

# Rubric judge. Leave the key empty to use the deterministic stub judge,
# which scores from the transcript without any model call.
JUDGE_PROVIDER=stub
JUDGE_MODEL=claude-sonnet-5
ANTHROPIC_API_KEY=

# Optional: where the local SQLite file lives. Defaults to ./data/sparbird.db
SPARBIRD_DB=
